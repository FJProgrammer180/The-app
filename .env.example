# ---------------------------------------------------------------------------
# NEXORA — environment template
# Copy to .env.local (development) or set these in your host's dashboard.
# Only NEXT_PUBLIC_* values are inlined into the browser bundle.
# ---------------------------------------------------------------------------

# Public: Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public: publishable / anon key. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only: service role key. NEVER expose this to the browser or commit it.
# Used only for privileged maintenance tasks; every request that uses it is
# already gated behind requireAdmin().
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public: canonical origin used for metadata, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: homepage background video. Leave unset and drop a licensed file at
# public/media/hero.mp4 (plus public/media/hero-poster.jpg) instead.
# NEXT_PUBLIC_HERO_VIDEO_URL=

# Optional: licensed .glb artifact for the 3D hero. Leave unset to use the
# procedural scene.
# NEXT_PUBLIC_HERO_MODEL_URL=
